{
  "$comment": "Digitexa UI registry. `npm run registry` compiles this into public/r/*.json.",
  "name": "digitexa-ui",
  "items": [
    {
      "name": "utils",
      "type": "lib",
      "description": "cn() — clsx + tailwind-merge, aware of the kit's font scale.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [{ "src": "lib/utils.ts", "target": "lib/utils.ts" }]
    },
    {
      "name": "theme",
      "type": "style",
      "description": "Tokens (light/dark/accents) and the Tailwind v4 mapping. Add two @imports to globals.css.",
      "files": [
        { "src": "app/tokens.css", "target": "app/dx-tokens.css" },
        { "src": "app/theme.css", "target": "app/dx-theme.css" }
      ],
      "notes": "In globals.css, below `@import \"tailwindcss\";`, add:\n  @import \"./dx-tokens.css\";\n  @import \"./dx-theme.css\";"
    },
    {
      "name": "button",
      "type": "component",
      "description": "6 variants (primary, secondary, soft, ghost, danger, link), 5 sizes, asChild.",
      "dependencies": ["@radix-ui/react-slot", "class-variance-authority"],
      "requires": ["utils", "theme"],
      "files": [{ "src": "components/ui/button.tsx", "target": "components/ui/button.tsx" }]
    },
    {
      "name": "input",
      "type": "component",
      "description": "3 sizes, error state via aria-invalid.",
      "dependencies": ["class-variance-authority"],
      "requires": ["utils", "theme"],
      "files": [{ "src": "components/ui/input.tsx", "target": "components/ui/input.tsx" }]
    },
    {
      "name": "badge",
      "type": "component",
      "description": "Semantic + work status variants (backlog/todo/progress/review/done), StatusBadge.",
      "dependencies": ["class-variance-authority"],
      "requires": ["utils", "theme"],
      "files": [{ "src": "components/ui/badge.tsx", "target": "components/ui/badge.tsx" }]
    },
    {
      "name": "dialog",
      "type": "component",
      "description": "Built on Radix Dialog; header/body/footer, 3 sizes.",
      "dependencies": ["@radix-ui/react-dialog", "lucide-react"],
      "requires": ["utils", "theme"],
      "files": [{ "src": "components/ui/dialog.tsx", "target": "components/ui/dialog.tsx" }]
    }
  ]
}
